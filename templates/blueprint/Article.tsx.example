// Copy to components/articles/YourTopicArticle.tsx after registering the topic.
// Every blueprint uses the same twelve sections (data/topics/article-format.ts);
// tests/article-layout.test.ts fails if a section is missing or out of order.
import { BlueprintArticleFrame, BlueprintSection, BlueprintPanel } from "@/components/articles/BlueprintArticleFrame";
import { FailuresSection, FollowUpsSection, InterviewSection, RunbookSection, ScaleSection, SourcesSection, TradeoffsSection } from "@/components/articles/BlueprintSections";
import { InlineCheck } from "@/components/InlineCheck";
import { getTopicById, type TopicId } from "@/data/topics/catalog";
import { topicQuizzes } from "@/data/topics/quizzes";
import { articleToc } from "@/data/topics/article-format";
import neo from "@/components/Neo.module.css";
// Import a topic-specific client workbench and diagram when ready.

const TOPIC_ID = "replace-with-registered-topic-id" satisfies TopicId;
const toc = articleToc({
  problem: "TODO: The production situation",
  naive: "TODO: Why the first design fails",
  "mental-model": "TODO: The distinction that makes it tractable",
  architecture: "TODO: The design",
  "worked-example": "TODO: Explore the failure",
  scale: "TODO: What breaks at ten times the load?",
});

export function YourTopicArticle() {
  const topic = getTopicById(TOPIC_ID);
  const questions = topicQuizzes[TOPIC_ID];
  const checkpoint = questions[0];
  return <BlueprintArticleFrame topicId={TOPIC_ID} toc={toc}>
    <BlueprintSection id="problem" number="01" title="TODO: The production situation">
