      <InlineCheck className={neo.conceptCheck} question={checkpoint.scenario} options={checkpoint.options.map(option => ({ label: option.text, isCorrect: option.isCorrect, explanation: option.explanation }))} />
    </BlueprintSection>
    <BlueprintSection id="mental-model" number="03" title="TODO: The distinction that makes it tractable">
      <p>TODO: Explain the distinction that makes the problem easier to reason about.</p>
    </BlueprintSection>
    <BlueprintSection id="architecture" number="04" title="TODO: The design">
      <p>TODO: Trace one successful operation and one failure through the design.</p>
      <BlueprintPanel kind="diagram">{/* Insert a compact, labeled diagram here; do not stretch it to prose width. */}</BlueprintPanel>
    </BlueprintSection>
    <BlueprintSection id="worked-example" number="05" title="TODO: Explore the failure">
      <p>TODO: Tell the reader which assumption to change and what to observe.</p>
      <BlueprintPanel id="workbench">{/* Insert a topic-specific client workbench here. */}</BlueprintPanel>
    </BlueprintSection>
    <RunbookSection steps={["TODO: Detect", "TODO: Mitigate", "TODO: Verify and roll back"]} />
    <TradeoffsSection tables={[{ caption: "TODO: Decisions and their costs", headers: ["Decision", "Benefit", "Cost"], rows: [["TODO", "TODO", "TODO"]] }]} />
    <FailuresSection failures={[{ title: "TODO: Failure mode", signal: "TODO: How you notice", response: "TODO: What you do" }]} />
    <ScaleSection title="TODO: What breaks at ten times the load?" items={["TODO: The next limit"]} />
    <InterviewSection
      answer="TODO: A one-minute spoken answer."
      levels={[
        { title: "Mid-level", description: "TODO", items: ["TODO"] },
        { title: "Senior", description: "TODO", items: ["TODO"] },
        { title: "Staff", description: "TODO", items: ["TODO"] },
      ]}
      wrongAnswers={[{ question: "TODO: Why not the obvious fix?", explanation: "TODO" }]}
      traps={["TODO: A trap to call out"]}
    />
    <FollowUpsSection items={[["TODO: Follow-up question", "TODO: Answer"]]} />
    <SourcesSection topicId={TOPIC_ID} sources={[["TODO: Primary source", "https://example.com"]]} quiz={{ title: topic.meta.title, questions, href: `${topic.href}/quiz` }} related={[]} />
  </BlueprintArticleFrame>;
}
